{
	"schemaVersion": 1,
	"id": "agentcraft",
	"version": "${version}",
	"name": "T3Craft",
	"description": "Minecraft as a spatial interface for T3 Code threads and agents.",
	"authors": [
		"Blendi",
		"Maxwell Young (adapted T3 client)"
	],
	"license": "MIT",
	"icon": "assets/agentcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.agentcraft.AgentCraft"
		],
		"client": [
			"dev.agentcraft.client.AgentCraftClient"
		]
	},
	"mixins": [
		"agentcraft.mixins.json",
		{
			"config": "agentcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": ">=${fabric_api_version}"
	}
}
